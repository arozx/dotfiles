# External Account Settings
source ~/.mutt/account.rc

#  Inbox Configuration 
set folder = "~/.mail/disroot"
set mbox_type = Maildir
set my_inbox = "+INBOX"
set spoolfile = $my_inbox
set mbox = $my_inbox
set record = "+Sent"
set postponed = "+Drafts"

#  Mail Sync 
macro index <F5> "<enter-command>unset wait_key<enter><shell-escape>~/.mutt/sync-and-index.sh<enter><enter-command>set wait_key<enter>"
folder-hook $my_inbox 'push "<enter-command>unset wait_key<enter><shell-escape>~/.mutt/sync-and-index.sh<enter><enter-command>set wait_key<enter>"'

#  urlview
macro index,pager \cu "<pipe-message> urlview<Enter>" "call urlscan to extract URLs out of a message"
macro attach,compose \cu "<pipe-entry> urlview<Enter>" "call urlscan to extract URLs out of a message"

#  Editor & UI 
set editor = "nvim"
set charset = "utf-8"
set sleep_time = 1

#  IMAP/SSL 
set move = no
set imap_keepalive = 300
set ssl_force_tls = yes
set ssl_starttls = yes

#  GPG / PGP 
unset crypt_opportunistic_encrypt   # Don't auto-decide
set crypt_use_gpgme = yes           # Use gpgme backend
set crypt_autosign = yes            # Sign by default
set crypt_replysign = yes
set crypt_replyencrypt = yes
set crypt_replysignencrypted = yes
set pgp_sign_as = CD33F70BC5280C35A6F8C91F12266DAB926884FB

#  Performance Optimizations 
set sort = "date"
unset sort_aux
unset strict_threads
unset mark_old

#  Notmuch Macros 
macro index,pager \Cs "<shell-escape>notmuch search " "Notmuch search"
macro index,pager \Ck "<shell-escape>notmuch show " "Notmuch show"
